#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# Root-context init: create app-owned config/data paths, then hand off to
# abc. Do not recursively chown /data — it may be a large NAS media tree
# owned by the host; only touch the app's own subtree under it.
paths=(
  /config
  /config/audiarr
  /config/logs
)
mkdir -p "${paths[@]}"
chown -R abc:abc /config

data_root="${AUDIARR_DEFAULT_ROOT_FOLDER:-/data/audiobooks}"
mkdir -p "$data_root"
chown abc:abc "$data_root"
