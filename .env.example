PUID=1000
PGID=1000
TZ=Europe/Berlin
UMASK=002
AUDIARR_HOST=0.0.0.0
AUDIARR_PORT=8787
AUDIARR_CONFIG_DIR=/config
AUDIARR_DEFAULT_ROOT_FOLDER=/data/audiobooks
